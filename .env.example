# ==============================================================================
# Mentorship App Root Environment Configuration Template
# ==============================================================================
# Use this template to create a root '.env' file for local Docker Compose runs.
# Keep the actual secrets outside of the repository and add '.env' to gitignore.

# ------------------------------------------------------------------------------
# Security Secrets
# ------------------------------------------------------------------------------
# Shared JWT sign/verify key across all microservices (Auth, Gateway, Books, Mentorship)
JWT_SECRET=
REFRESH_SECRET=

# ------------------------------------------------------------------------------
# Third-Party API Integration Credentials
# ------------------------------------------------------------------------------
# Cloudinary Storage Configuration (used by booksservice for resources upload)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Hugging Face Inference API credentials (used by mentorshipservice for AI Advisor)
HUGGINGFACE_API_KEY=

# Google OAuth Client Credentials (used by authservice for social login)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Resend API Key for sending emails (used by authservice)
RESEND_API_KEY=

# SMTP credentials (fallback for email sending)
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASS=
SMTP_FROM_EMAIL=
